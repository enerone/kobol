# Copy to .env and replace every CHANGE_ME value.
COMPOSE_PROJECT_NAME=kobol-hermes

# Host exposure. Keep loopback unless an authenticated reverse proxy is added.
APP_BIND_HOST=127.0.0.1
HERMES_API_PORT=8642
HERMES_DASHBOARD_PORT=9119
OMNIROUTE_DASHBOARD_PORT=20128
OMNIROUTE_API_PORT=20129
OMNIROUTE_LIVE_WS_PORT=20132

# Hermes authentication.
HERMES_DASHBOARD_USER=admin
HERMES_DASHBOARD_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
HERMES_API_KEY=CHANGE_ME_LONG_RANDOM_API_KEY

# OmniRoute authentication. Create/use this key in the OmniRoute dashboard.
OMNIROUTE_API_KEY=CHANGE_ME_OMNIROUTE_API_KEY
OMNIROUTE_INITIAL_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
OMNIROUTE_WS_BRIDGE_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
OMNIROUTE_MEMORY_MB=2048

# Optional direct provider keys. Provider accounts still enforce their own quotas.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
